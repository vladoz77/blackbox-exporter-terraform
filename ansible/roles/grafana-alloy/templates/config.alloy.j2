// Remote write endpoint for metrics storage in VictoriaMetrics-compatible API.
prometheus.remote_write "prometheus" {
  endpoint {
    url = "{{ alloy_prometheus_scheme }}://{{ prometheus_url }}/api/v1/write"
{% if alloy_skip_tls_verify %}
    // Use only in trusted environments with self-signed or internal certificates.
    tls_config {
      insecure_skip_verify = true
    }
{% endif %}
  }
}

// Loki destination for logs collected by journal, files and docker.
loki.write "loki" {
  endpoint {
    url = "{{ alloy_loki_scheme }}://{{ loki_url }}/loki/api/v1/push"
    batch_size = "1MiB"
    batch_wait = "2s"
  }
  
}
{% if alloy_enable_docker %}
// Export per-container runtime metrics from the local Docker daemon.
prometheus.exporter.cadvisor "docker" {
  docker_host = "unix:///var/run/docker.sock"
  storage_duration = "5m"
}

prometheus.scrape "docker" {
  targets    =  prometheus.exporter.cadvisor.docker.targets
  // Normalize labels before forwarding metrics to remote_write.
  forward_to = [prometheus.relabel.docker_relabel.receiver]
}

// Attach stable labels that are easier to query in dashboards and alerts.
prometheus.relabel "docker_relabel" {
  rule {
    target_label = "container"
    source_labels = [
      "name",
    ]
  }
  
  rule {
    target_label = "job"
    replacement = "docker-metrics"
  }
  
  forward_to = [prometheus.remote_write.prometheus.receiver]
}
{% endif %}

// Host-level node metrics similar to node_exporter.
prometheus.exporter.unix "metrics" {
  disable_collectors = ["ipvs", "btrfs", "infiniband", "xfs", "zfs"]
  enable_collectors = ["meminfo"]

  // Skip pseudo filesystems and docker mounts to reduce noise.
  filesystem {
    fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|tmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs)$"
    mount_points_exclude = "^/(dev|proc|run/credentials/.+|sys|var/lib/docker/.+)($|/)"
    mount_timeout        = "5s"
  }

  // Ignore short-lived virtual interfaces created by containers and CNI.
  netclass {
    ignored_devices = "^(veth.*|cali.*|[a-f0-9]{15})$"
  }

  netdev {
    device_exclude = "^(veth.*|cali.*|[a-f0-9]{15})$"
  }
}

prometheus.scrape "linux_node" {
  scrape_interval = "15s"
  targets = prometheus.exporter.unix.metrics.targets
  forward_to = [
    prometheus.relabel.metrics.receiver,
  ]
}

// Scrape Traefik metrics from the local host.
prometheus.scrape "traefik" {
  targets = [{
    __address__ = "127.0.0.1:8082",
    job         = "traefik",
    instance    = constants.hostname,
  }]
  forward_to = [prometheus.remote_write.prometheus.receiver]
}


// Add host labels to system metrics before shipping them out.
prometheus.relabel "metrics" {
  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }

  rule {
    target_label = "job"
    replacement = "linux-node"
  }
  
  forward_to = [prometheus.remote_write.prometheus.receiver]
}

// Collect selected logs from journald.
loki.source.journal "journal" {
  max_age    = "12h0m0s"
  forward_to = [loki.write.loki.receiver]
  path          = "/var/log/journal"
  relabel_rules = loki.relabel.journal.rules
}

// Keep only allowlist of important service logs.
loki.relabel "journal" {
  forward_to = []
  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "^(docker|containerd|kubelet|nginx|postgresql|sshd|fail2ban|alloy)\\.service$"
    action        = "keep"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal__boot_id"]
    target_label  = "boot_id"
  }
  rule {
    source_labels = ["__journal__transport"]
    target_label  = "transport"
  }
  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
  rule {
    target_label = "job"
    replacement  = "systemd-journal"
  }
}

// Tail text log files.
loki.source.file "system" {
  targets    = local.file_match.system.targets
  forward_to = [loki.write.loki.receiver]
}

// Each path target becomes a Loki stream with stable host and log_type labels.
local.file_match "system" {
  path_targets = [
    {
      __address__ = "localhost",
      __path__    = "/var/log/messages",
      job         = "system-logs",
      log_type    = "messages",
      instance    = constants.hostname,
    },
    {
      __address__ = "localhost",
      __path__    = "/var/log/secure",
      job         = "system-logs",
      log_type    = "secure",
      instance    = constants.hostname,
    },
    {
      __address__ = "localhost",
      __path__    = "/var/log/cron",
      job         = "system-logs",
      log_type    = "cron",
      instance    = constants.hostname,
    },
    {
      __address__ = "localhost",
      __path__    = "/var/log/boot.log",
      job         = "system-logs",
      log_type    = "boot",
      instance    = constants.hostname,
    },
    {
      __address__ = "localhost",
      __path__    = "/var/log/auth.log",
      job         = "system-logs",
      log_type    = "auth",
      instance    = constants.hostname,
    },
    {
      __address__ = "localhost",
      __path__    = "/var/log/syslog",
      job         = "system-logs",
      log_type    = "syslog",
      instance    = constants.hostname,
    },
    {
      __address__ = "localhost",
      __path__    = "/var/log/fail2ban.log",
      job         = "system-logs",
      log_type    = "fail2ban",
      instance    = constants.hostname,
    },
    {
      __address__ = "localhost",
      __path__    = "/var/log/nginx/access.log",
      job         = "system-logs",
      log_type    = "nginx",
      instance    = constants.hostname,
    },
    {
      __address__ = "localhost",
      __path__    = "/var/log/dnf.log",
      job         = "system-logs",
      log_type    = "dnf",
      instance    = constants.hostname,
    },
  ]
}

{% if alloy_enable_docker %}
// Discover running containers to collect stdout/stderr logs from Docker.
discovery.docker "dockerlogs" {
  host = "unix:///var/run/docker.sock"
}

// Promote a few docker metadata fields to query-friendly labels.
discovery.relabel "dockerlogs" {
  targets = discovery.docker.dockerlogs.targets
  
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex = "/(.*)"
    target_label = "container_name"
  }
  
  rule {
    source_labels = ["__meta_docker_container_image"]
    target_label = "container_image"
  }
}

// Stream Docker container logs to Loki.
loki.source.docker "default" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.dockerlogs.targets
  labels     = {"platform" = "docker"}
  relabel_rules = discovery.relabel.dockerlogs.rules
  forward_to = [loki.write.loki.receiver]
}
{% endif %}
// Enable Alloy live debugging endpoints with default settings.
livedebugging{}
